# Generated by ns2gen (wired scenario)

set ns [new Simulator]

$ns color 1 Blue
$ns color 2 Red

set tf [open out.tr w]
$ns trace-all $tf
set nf [open out.nam w]
$ns namtrace-all $nf

proc finish {} {
    global ns nf tf
    $ns flush-trace
    close $nf
    close $tf
    exec nam out.nam &
    exit 0
}

set n0 [$ns node]
set n1 [$ns node]  ;# mid
set n2 [$ns node]

$ns duplex-link $n2 $n1 1Mb 10ms DropTail
$ns duplex-link-op $n2 $n1 orient right
$ns duplex-link $n1 $n0 100Kb 1s DropTail
$ns duplex-link-op $n1 $n0 orient right-up

# Flow 1: TCP/FTP  node 9 -> node 2
set tcp0 [new Agent/TCP]
set sink0 [new Agent/TCPSink]
$tcp0 set class_ 1
$ns attach-agent $n2 $tcp0
$ns attach-agent $n0 $sink0
$ns connect $tcp0 $sink0
set ftp0 [new Application/FTP]
$ftp0 attach-agent $tcp0
$ns at 1 "$ftp0 start"
$ns at 4 "$ftp0 stop"

# Flow 2: UDP/CBR  node 2 -> node 9
set udp0 [new Agent/UDP]
set null0 [new Agent/Null]
$udp0 set class_ 2
$ns attach-agent $n0 $udp0
$ns attach-agent $n2 $null0
$ns connect $udp0 $null0
set cbr0 [new Application/Traffic/CBR]
$cbr0 set packetSize_ 1000
$cbr0 set rate_ 500k
$cbr0 attach-agent $udp0
$ns at 0 "$cbr0 start"
$ns at 5 "$cbr0 stop"

$ns at 5 "finish"
$ns run
