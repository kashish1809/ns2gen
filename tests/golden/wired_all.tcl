# Generated by ns2gen (wired scenario)

set ns [new Simulator]

$ns color 1 Blue
$ns color 2 Red
$ns color 3 Green
$ns color 4 Orange
$ns color 5 Purple
$ns color 6 Brown
$ns color 7 Magenta
$ns color 8 Cyan
$ns color 9 Blue
$ns color 10 Red
$ns color 11 Green

set tf [open run/a_1.tr w]
$ns trace-all $tf
set nf [open run/a_1.nam w]
$ns namtrace-all $nf

proc finish {} {
    global ns nf tf
    $ns flush-trace
    close $nf
    close $tf
    exit 0
}

set n0 [$ns node]  ;# hub
set n1 [$ns node]  ;# edge 1
set n2 [$ns node]  ;# edge 2
set n3 [$ns node]
set n4 [$ns node]
set n5 [$ns node]
set n6 [$ns node]
set n7 [$ns node]
set n8 [$ns node]

$ns duplex-link $n0 $n1 1.5Mb 1.25ms DropTail
$ns duplex-link-op $n0 $n1 orient right
$ns simplex-link $n0 $n2 2.5Mb 2.25ms RED
$ns simplex-link-op $n0 $n2 orient right-up
$ns duplex-link $n0 $n3 3.5Mb 3.25ms FQ
$ns duplex-link-op $n0 $n3 orient up
$ns queue-limit $n0 $n3 30
$ns queue-limit $n3 $n0 30
$ns simplex-link $n0 $n4 4.5Mb 4.25ms SFQ
$ns simplex-link-op $n0 $n4 orient left-up
$ns duplex-link $n0 $n5 5.5Mb 5.25ms DRR
$ns duplex-link-op $n0 $n5 orient left
$ns simplex-link $n0 $n6 6.5Mb 6.25ms DropTail
$ns simplex-link-op $n0 $n6 orient left-down
$ns queue-limit $n0 $n6 60
$ns duplex-link $n0 $n7 7.5Mb 7.25ms RED
$ns duplex-link-op $n0 $n7 orient down
$ns simplex-link $n0 $n8 8.5Mb 8.25ms FQ
$ns simplex-link-op $n0 $n8 orient right-down

# Flow 1: TCP/FTP  node 1 -> node 5
set tcp0 [new Agent/TCP/Reno]
set sink0 [new Agent/TCPSink]
$tcp0 set window_ 20
$tcp0 set class_ 1
$ns attach-agent $n1 $tcp0
$ns attach-agent $n5 $sink0
$ns connect $tcp0 $sink0
set ftp0 [new Application/FTP]
$ftp0 attach-agent $tcp0
$ns at 0.25 "$ftp0 start"
$ns at 3.33333 "$ftp0 stop"

# Flow 2: TCP/FTP  node 3 -> node 7
set tcp1 [new Agent/TCP/Newreno]
set sink1 [new Agent/TCPSink]
