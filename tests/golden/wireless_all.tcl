# Generated by ns2gen (wireless scenario)

set val(chan) Channel/WirelessChannel
set val(prop) Propagation/FreeSpace
set val(netif) Phy/WirelessPhy
set val(mac) Mac/Simple
set val(ifq) Queue/DropTail
set val(ll) LL
set val(ant) Antenna/OmniAntenna
set val(ifqlen) 100
set val(nn) 4
set val(rp) DSDV
set val(x) 1000.5
set val(y) 750
set val(stop) 33.33

set ns [new Simulator]
set tracefd [open w.tr w]
$ns trace-all $tracefd
set namtrace [open w.nam w]
$ns namtrace-all-wireless $namtrace $val(x) $val(y)

set topo [new Topography]
$topo load_flatgrid $val(x) $val(y)
create-god $val(nn)

$ns node-config -adhocRouting $val(rp) \
    -llType $val(ll) \
    -macType $val(mac) \
    -ifqType $val(ifq) \
    -ifqLen $val(ifqlen) \
    -antType $val(ant) \
    -propType $val(prop) \
    -phyType $val(netif) \
    -channelType $val(chan) \
    -topoInstance $topo \
    -agentTrace ON \
    -routerTrace ON \
    -macTrace OFF \
    -movementTrace ON

proc finish {} {
    global ns tracefd namtrace
    $ns flush-trace
    close $tracefd
    close $namtrace
    exit 0
}

set node_(0) [$ns node]  ;# a
$node_(0) random-motion 0
$node_(0) set X_ 12.3457
$node_(0) set Y_ 99.5
$node_(0) set Z_ 0.0
$ns initial_node_pos $node_(0) 30

set node_(1) [$ns node]
$node_(1) random-motion 0
$node_(1) set X_ 500
$node_(1) set Y_ 375
$node_(1) set Z_ 0.0
$ns initial_node_pos $node_(1) 30

set node_(2) [$ns node]
$node_(2) random-motion 0
$node_(2) set X_ 1000.5
$node_(2) set Y_ 750
$node_(2) set Z_ 0.0
$ns initial_node_pos $node_(2) 30

set node_(3) [$ns node]
$node_(3) random-motion 0
$node_(3) set X_ 0
$node_(3) set Y_ 0
$node_(3) set Z_ 0.0
$ns initial_node_pos $node_(3) 30

$ns at 0 "$node_(1) setdest 1 1 1"
$ns at 5.5 "$node_(0) setdest 900 700 10"
$ns at 5.5 "$node_(2) setdest 10 10 0.5"
$ns at 20 "$node_(1) setdest 100 100 2.5"

# Flow 1: TCP/FTP  node 0 -> node 3
set tcp0 [new Agent/TCP/Sack1]
set sink0 [new Agent/TCPSink/Sack1]
$tcp0 set window_ 8
$ns attach-agent $node_(0) $tcp0
$ns attach-agent $node_(2) $sink0
$ns connect $tcp0 $sink0
set ftp0 [new Application/FTP]
$ftp0 attach-agent $tcp0
$ns at 1 "$ftp0 start"
$ns at 30 "$ftp0 stop"

# Flow 2: UDP/CBR  node 1 -> node 7
set udp0 [new Agent/UDP]
set null0 [new Agent/Null]
$ns attach-agent $node_(1) $udp0
$ns attach-agent $node_(3) $null0
$ns connect $udp0 $null0
set cbr0 [new Application/Traffic/CBR]
$cbr0 set packetSize_ 64
$cbr0 set rate_ 2m
$cbr0 attach-agent $udp0
$ns at 2 "$cbr0 start"
$ns at 33 "$cbr0 stop"

for {set i 0} {$i < $val(nn)} {incr i} {
    $ns at $val(stop) "$node_($i) reset"
}
$ns at $val(stop) "finish"
puts "Starting simulation..."
$ns run
